+		await fs.writeFile(projectPath, JSON.stringify(project), "utf8");
+		const started = await runCommand(["edit", projectPath]);
+		expect(started).toMatchObject({
+			ok: true,
+			command: "edit",
+			host: "127.0.0.1",
+			projectId: "proj_cli",
